# Optional. Used only by `python scripts/pull_live_data.py <city> --places`
# (never on page load). Without it, competitor counts come from OpenStreetMap.
# Get a key: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Enable "Places API (New)" for the project.
GOOGLE_PLACES_API_KEY=

# Overpass API endpoint used by pull_live_data.py. If the default returns
# HTTP 504 (busy), try the mirror: https://overpass.kumi.systems/api/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter
